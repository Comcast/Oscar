# Exact exporter fixtures must match canonical LF output on every OS.
/src/test/resources/export-text/*.txt text eol=lf
# Preserve ANTLR generator output verbatim, including its trailing spaces.
/src/com/comcast/oscar/parser/tlv*.java whitespace=-blank-at-eol

# Keep wrapper launchers usable on Unix and Windows checkouts.
/mvnw text eol=lf
/mvnw.cmd text eol=crlf

# Provenance hashes cover exact extracted bytes, including original line endings.
/skills/**/references/sources/*.txt -text

# Preserve upstream PacketCable fixture/source bytes and their provenance hashes.
/src/test/resources/packetcable-public/*.bin -text
/src/test/resources/packetcable-public/*.cm -text
/src/test/resources/packetcable-public/*.txt -text
/src/test/resources/packetcable-public/*.conf -text
