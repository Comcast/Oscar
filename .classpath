<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry excluding="com/comcast/oscar/examples/**|com/comcast/oscar/test/**|test/**" including="**/*.java" kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="lib/antlr-4.1-complete.jar"/>
	<classpathentry kind="lib" path="lib/commons-cli-1.2.jar"/>
	<classpathentry kind="lib" path="lib/commons-collections4-4.0.jar"/>
	<classpathentry kind="lib" path="lib/jackson-annotations-2.5.0.jar"/>
	<classpathentry kind="lib" path="lib/jackson-core-2.5.0.jar"/>
	<classpathentry kind="lib" path="lib/jackson-databind-2.5.3.jar"/>
	<classpathentry kind="lib" path="lib/json-2.1.jar"/>
	<classpathentry kind="lib" path="lib/log4j-api-2.8.2.jar"/>
	<classpathentry kind="lib" path="lib/log4j-core-2.8.2.jar"/>
	<classpathentry kind="lib" path="lib/snmp4j-2.3.0.jar"/>
	<classpathentry kind="lib" path="lib/zip4j_1.3.2.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry excluding="**" kind="src" output="target/classes" path="res">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="optional" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" path="target/generated-sources/annotations">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="ignore_optional_problems" value="true"/>
			<attribute name="m2e-apt" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" output="target/test-classes" path="target/generated-test-sources/test-annotations">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
			<attribute name="ignore_optional_problems" value="true"/>
			<attribute name="m2e-apt" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
